modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AGENTICORG_BASE_URL = "https://agenticorg.hackathon.pinelabs.com"
AGENTICORG_PLANNER_ID = "4df6fad9-59cc-4b6b-bd26-56a08fef55bf"
